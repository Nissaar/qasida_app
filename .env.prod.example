# Copy to .env beside docker-compose.prod.yml and fill in.
# .env is gitignored: never commit real values.

# The domain Traefik will route. Add more with a || rule in the compose labels.
SITE_HOST=qasida.example.com

# Must list every hostname the site answers on, comma separated.
DJANGO_ALLOWED_HOSTS=qasida.example.com

# Needed for admin logins and the suggestion form: Django checks the browser's
# Origin against this for POSTs. Include the scheme.
DJANGO_CSRF_TRUSTED_ORIGINS=https://qasida.example.com

# Generate a fresh one, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me

DB_NAME=qasida_db
DB_USER=qasida_user
DB_PASSWORD=replace-me

# ---------------------------------------------------------------------------
# Password reset mail
#
# Without this Django prints the reset link to the container log instead of
# sending it, so nobody can recover an account. Choose ONE of the two blocks.
# ---------------------------------------------------------------------------

# --- Mailgun (simplest) ----------------------------------------------------
# In the Mailgun dashboard open your sending domain, find "SMTP credentials",
# and copy the login and password from there.
#
#   MAILGUN_SMTP_LOGIN     the postmaster@mg.yourdomain.com style user
#   MAILGUN_SMTP_PASSWORD  that domain's SMTP password
#
# NOT the account API key. That is a different credential and it will be
# rejected at send time; the app warns on startup if it looks like one.
#
# MAILGUN_REGION is us or eu, and must match where the domain was created:
# a domain in one region cannot send through the other's host, and the error
# looks like a wrong password.
#
# DJANGO_DEFAULT_FROM_EMAIL must be on the domain Mailgun is sending for, or
# Mailgun refuses the message.
MAILGUN_SMTP_LOGIN=postmaster@mg.qasida.example.com
MAILGUN_SMTP_PASSWORD=replace-me
MAILGUN_REGION=us
DJANGO_DEFAULT_FROM_EMAIL=no-reply@mg.qasida.example.com

# --- or any other SMTP provider -------------------------------------------
# Leave the Mailgun lines above empty and fill these in instead.
#DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#DJANGO_EMAIL_HOST=smtp.example.com
#DJANGO_EMAIL_PORT=587
#DJANGO_EMAIL_HOST_USER=replace-me
#DJANGO_EMAIL_HOST_PASSWORD=replace-me
#DJANGO_EMAIL_USE_TLS=True
#DJANGO_DEFAULT_FROM_EMAIL=no-reply@qasida.example.com

# Once it is set, check delivery without waiting for a reader to ask:
#   docker compose -f docker-compose.prod.yml exec web \
#       python manage.py sendtestemail you@example.com
