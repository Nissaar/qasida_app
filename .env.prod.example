# Copy to .env beside docker-compose.prod.yml and fill in.
# .env is gitignored: never commit real values.

# The domain Traefik will route. Add more with a || rule in the compose labels.
SITE_HOST=qasida.example.com

# Must list every hostname the site answers on, comma separated.
DJANGO_ALLOWED_HOSTS=qasida.example.com

# Needed for admin logins and the suggestion form: Django checks the browser's
# Origin against this for POSTs. Include the scheme.
DJANGO_CSRF_TRUSTED_ORIGINS=https://qasida.example.com

# Generate a fresh one, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me

DB_NAME=qasida_db
DB_USER=qasida_user
DB_PASSWORD=replace-me

# Password reset mail. Without these Django prints the reset link to the
# container log rather than sending it, so nobody can recover an account.
# Any SMTP provider will do; these are the settings it gives you.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=replace-me
DJANGO_EMAIL_HOST_PASSWORD=replace-me
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=no-reply@qasida.example.com
